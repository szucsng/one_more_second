text = ""

[node name="ToggleButton" type="Button" parent="."]
custom_minimum_size = Vector2(154, 64)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"ToggleButton"
toggle_mode = true
text = "ON"
script = ExtResource("2_neon")
plays_sound = false
